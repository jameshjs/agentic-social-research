# Copy to .env and fill in. .env is git-ignored; this example is safe to commit.

# --- Persona console (runtime/server.js) ---
# Teammates: AGENT_BACKEND=remote, with Steven's AGENT_SERVER_URL and CONSOLE_ACCESS_KEY.
# Steven's machine: token (CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`) or local (this machine's claude login).
# Also: api (opt-in, billed per token; needs npm install in runtime/) or replay (saved runs only, no model access).
AGENT_BACKEND=
AGENT_SERVER_URL=
# Required whenever the server binds beyond 127.0.0.1 (--lan, --host); sent by the console as a bearer token.
# Change it here to rotate it; the server re-reads it on every request.
CONSOLE_ACCESS_KEY=
# Only on the machine that runs the agents. Never share it, commit it or paste it anywhere else.
CLAUDE_CODE_OAUTH_TOKEN=
CONSOLE_HOST=
CONSOLE_PORT=
AGENT_CONCURRENCY=

# --- Tuning loop ---
PAPIERS_TOKEN=
# Anthropic API backend for scripts/plan.py: an Opus planner that fans out persona agents (Haiku).
# Everything else uses the logged-in `claude` CLI. Never export the key into your shell,
# or `claude -p` switches from your Claude plan to API billing.
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-opus-5-5
PERSONA_MODEL=claude-haiku-5-5
# Optional Vultr-only live survey path: python3 scripts/plan.py --provider vultr "..."
# This key is server-side only. MLH/new-account credit eligibility must be confirmed in the Vultr account.
VULTR_INFERENCE_API_KEY=
VULTR_ORCHESTRATOR_MODEL=glm-5.3
VULTR_PERSONA_MODEL=glm-5.3-flash
