{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "persona-agents",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "persona-swarm/runtime", "start"],
      "port": 4174
    },
    {
      "name": "persona-agents-replay",
      "runtimeExecutable": "node",
